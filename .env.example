# Local: copy to .env.local for `npm run dev`. Live: add the same names in Cloudflare › Workers ›
# wandercafe-monset › Settings › Variables and Secrets (as Secrets). Never commit the real file.

# The DASHBOARD's Supabase project (same values as the dashboard Worker): Project Settings › API.
# The service_role key is server-only; it never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo dashboard › Developers › API keys. Use sk_test_ until the owner's account is activated.
PAYMONGO_SECRET_KEY=
# The secret key PayMongo gives you when you register the webhook (README › Go live).
PAYMONGO_WEBHOOK_SECRET=

# Optional: the public site URL PayMongo sends guests back to. Defaults to the current host.
SITE_URL=
